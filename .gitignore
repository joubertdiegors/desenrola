# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Ambiente virtual ---
.venv/
venv/
env/

# --- Segredos e configuracao local ---
.env
.env.*
!.env.example

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/*
!/media/.gitkeep

# --- Traducoes compiladas ---
# Os .po sao versionados; os .mo sao gerados por compilemessages.
*.mo
# Excecao: os catalogos do proprio projeto. Nao ha passo de build que os
# compile (o compilemessages do Django exige o GNU gettext, ausente no
# Windows -- por isso existe scripts/compile_messages.py, que se roda a
# mao). Se o .mo nao fosse versionado, um clone novo nao teria as
# mensagens do Django em portugues e os testes da Etapa 4.1 falhariam.
!/locale/**/*.mo

# --- Testes e ferramentas ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Editores e sistema operacional ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

