# Desenrola - exemplo de configuracao de ambiente.
# Copie para `.env` e ajuste. O arquivo `.env` NUNCA vai para o Git.

# ---------------------------------------------------------------------------
# Obrigatorio
# ---------------------------------------------------------------------------

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave

DEBUG=True

# Lista separada por virgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
#
# Em desenvolvimento, se DATABASE_URL for omitido, o projeto usa SQLite.
# Em producao a variavel e obrigatoria e precisa ser PostgreSQL.
#
# PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@host:5432/desenrola
#
# SQLite (apenas desenvolvimento):
# DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------------
# Producao
# ---------------------------------------------------------------------------

# CSRF_TRUSTED_ORIGINS=https://desenrola.be,https://www.desenrola.be

# E-mail de saida.
#
# A configuracao de VERDADE (servidor, usuario, senha, remetente) e
# cadastrada no BACKOFFICE, em /backoffice/email/ -- fica no banco, com a
# senha cifrada, e muda sem deploy. Nada de credencial de e-mail aqui.
#
# EMAIL_URL continua existindo so como RESERVA: para onde as mensagens
# vao enquanto nao houver configuracao ativa na tela. Sem ela, producao
# apenas registra os e-mails no log. Formato do django-environ:
# EMAIL_URL=smtp+tls://usuario:senha@smtp.exemplo.com:587
# DEFAULT_FROM_EMAIL=Desenrola <no-reply@exemplo.com>

# Chave que cifra a senha SMTP guardada no banco. Omitida, e derivada da
# SECRET_KEY -- o que significa que trocar a SECRET_KEY torna a senha
# guardada ilegivel (a tela avisa e o administrador cadastra outra).
# Defina uma propria para poder girar as duas de forma independente.
# Gere como a SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# EMAIL_SECRET_KEY=

# ---------------------------------------------------------------------------
# Desenvolvimento (opcional)
# ---------------------------------------------------------------------------

# Ativa o django-debug-toolbar.
DEBUG_TOOLBAR=False
